library(splcr)
library(survival)
# 1) Restart R 之后
library(splcr)
library(survival)
data(pbc, package="survival")
pbc_data <- subset(pbc, !is.na(trt))
pbc_data$status <- ifelse(pbc_data$status == 2, 1L, ifelse(pbc_data$status == 1, 2L, 0L))
pbc_data$time <- as.numeric(pbc_data$time)
pbc_data$logbili <- log(pbc_data$bili)
pbc_data$sex <- factor(pbc_data$sex)
pbc_data$stage <- factor(pbc_data$stage)
pbc_data$ascites <- factor(pbc_data$ascites)
pbc_data <- pbc_data[complete.cases(pbc_data[, c("time","status","logbili","albumin","protime","ascites","age","sex","stage")]), ]
View(pbc_data)
res10 <- spl_cr(
~ logbili + albumin + protime + ascites,
data = pbc_data,
folds = 10,
k_nn = 5,
kernel = "epanechnikov",
seed = 20250101
)
print(res10)
# 2) SPL-FG
res_fg10 <- spl_fg(~ logbili + albumin + protime + ascites,
data = pbc_data,
folds = 10, k_nn = 5, kernel = "epanechnikov",
seed = 20250101)
print(res_fg10)

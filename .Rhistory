# =============================================================================
# FIG_STEP_TO_SMOOTHING.R
# 2x2 mechanism figure for the real-data application (PBC):
# (A) Cause-specific hazards: Event rate
# (B) Cause-specific hazards: Cumulative risk
# (C) Fine–Gray: Event density
# (D) Fine–Gray: Cumulative incidence
#
# Output: PDF
# =============================================================================
rm(list = ls())
# ---------------------------- user settings ----------------------------------
PROJECT_ROOT <- getwd()  # put this script in your project root, or edit this path
CPP_FILE     <- file.path(PROJECT_ROOT, "Smoothing", "khs.cpp")
OUT_DIR      <- file.path(PROJECT_ROOT, "Results", "Figures")
OUT_PDF      <- file.path(OUT_DIR, "Fig_step_to_smoothing_PBC.pdf")
CAUSE_TO_SHOW <- 1L            # in your recoding: 1 = death, 2 = transplant
K_NN          <- 5L            # k for kNN bandwidth
KERNEL_ID     <- 3L            # 1=Uniform, 2=Triangular, 3=Epanechnikov, 4=Quartic
N_GRID        <- 600L          # grid resolution for smooth curves
set.seed(20250101)
# ---------------------------- packages ---------------------------------------
pkgs <- c("survival", "riskRegression", "dplyr", "tidyr", "ggplot2", "Rcpp", "patchwork")
missing_pkgs <- pkgs[!vapply(pkgs, requireNamespace, logical(1), quietly = TRUE)]
if (length(missing_pkgs) > 0) {
stop("Missing packages: ", paste(missing_pkgs, collapse = ", "),
"\nPlease install them before running this script.")
}

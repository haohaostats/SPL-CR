# ------------------------------------------------------------------------------
set.seed(123)
tau_len <- 40
fit <- bvar.sv.tvp(Y, p = 2, tau = tau_len, nrep = 5000, nburn = 1000, save.parameters = TRUE)
T_est <- dim(fit$Beta.postmean)[3]
# ==============================================================================
# Table 1: 描述性统计与平稳性检验 (Descriptive Statistics & Unit Root)
# ==============================================================================
if (!require(writexl)) install.packages("writexl")
if (!require(tseries)) install.packages("tseries")
if (!require(knitr)) install.packages("knitr")
library(writexl); library(tseries); library(knitr)
# 定义包含 PP 检验的统计函数
calc_full_stats <- function(x) {
# ADF 检验
adf <- adf.test(x)
# PP 检验 (Phillips-Perron)
pp <- pp.test(x)
c(Mean = mean(x),
Std_Dev = sd(x),
Min = min(x),
Max = max(x),
ADF_Stat = as.numeric(adf$statistic),
ADF_P = as.numeric(adf$p.value),
PP_Stat = as.numeric(pp$statistic),
PP_P = as.numeric(pp$p.value))
}
stats_matrix <- t(apply(Y, 2, calc_full_stats))
table1_final <- as.data.frame(stats_matrix)
var_symbols <- c("Δi_cn", "fxi", "Δs", "flow")
table1_final <- cbind(Variable = var_symbols, table1_final)
print(kable(table1_final, digits=3, caption="Table 1: Descriptive Statistics and Unit Root Tests (ADF & PP)"))
file_name <- "Table1_Descriptive_Stats_Final.xlsx"
file_path <- file.path(getwd(), file_name)
write_xlsx(table1_final, file_path)
# ==============================================================================
# Table 2: 滞后阶数选择 (Lag Length Selection Criteria)
# ==============================================================================
lag_select <- VARselect(Y, lag.max = 8, type = "const")
tbl2_data <- t(lag_select$criteria)
rownames(tbl2_data) <- paste0("Lag ", 1:8)
print(kable(tbl2_data, digits=3, caption="Table 2: Lag Length Selection Criteria"))
# Table 3: 随机波动率分期对比 (Estimated Stochastic Volatility)
# ==============================================================================
vol_mat <- matrix(0, T_est, 4)
for(t in 1:T_est) vol_mat[t, ] <- sqrt(diag(fit$H.postmean[,,t]))
idx_split <- 130
tbl3_data <- data.frame(
Variable = var_labels,
Full_Sample = colMeans(vol_mat),
Pre_Reform_Mean = colMeans(vol_mat[1:idx_split, ]),
Post_Reform_Mean = colMeans(vol_mat[(idx_split+1):T_est, ]),
Change_Pct = numeric(4)
)
tbl3_data$Change_Pct <- (tbl3_data$Post_Reform_Mean - tbl3_data$Pre_Reform_Mean) / tbl3_data$Pre_Reform_Mean
print(kable(tbl3_data, digits=3, caption="Table 3: Posterior Estimates of Stochastic Volatility (Regime Comparison)"))
library(ggplot2)
library(gridExtra)
library(reshape2)
library(dplyr)
safe_irf <- function(model, t_raw, imp, resp, hor=12) {
t_idx <- max(1, min(t_raw - tau_len, T_est))
res <- impulse.responses(model, impulse.variable=imp, response.variable=resp,
t=t_idx, nhor=hor, scenario=2, draw.plot=FALSE)
return(colMeans(res$irf))
}
# ==============================================================================
# Figure 1: 随机波动率时变趋势 (Stochastic Volatility)
# ==============================================================================
vol_mat <- matrix(0, T_est, 4)
for(t in 1:T_est) vol_mat[t, ] <- sqrt(diag(fit$H.postmean[,,t]))
colnames(vol_mat) <- var_labels
df_vol <- melt(as.data.frame(vol_mat))
df_vol$Time <- rep((1:T_est) + tau_len, 4)
p1 <- ggplot(df_vol, aes(x=Time, y=value)) +
geom_line(color="black", linewidth=0.6) +
facet_wrap(~variable, scales="free_y", ncol=2) +
geom_vline(xintercept = 175, linetype="dotted", color="red") + # 2015 Reform
labs(title="Figure 1: Time-Varying Stochastic Volatility (Posterior Mean)",
subtitle="Evidence of Heteroscedasticity across Regimes",
y="Volatility (Std Dev)", x="Time Index") +
theme_bw() +
theme(plot.title = element_text(face="bold"))
print(p1)
# ==============================================================================
# Table 4: 关键时点方差分解 (FEVD at Key Dates) - 验证 H1/H3
# ==============================================================================
calc_fevd_point <- function(model, t_idx) {
B <- model$Beta.postmean[,,t_idx]; Sigma <- model$H.postmean[,,t_idx]
M <- 4; K <- M*2
A <- B[,-1]; P <- t(chol(Sigma))
F_mat <- matrix(0,K,K); F_mat[1:M,1:K]<-A; F_mat[(M+1):K,1:M]<-diag(M)
J <- matrix(0,M,K); J[1:M,1:M]<-diag(M)
MSE <- matrix(0,M,M); Phi_pow <- diag(K)
for(h in 0:11) { # 12期累计 (Horizon = 12)
Theta <- J %*% Phi_pow %*% t(J) %*% P
MSE <- MSE + Theta^2
Phi_pow <- Phi_pow %*% F_mat
}
return(MSE / rowSums(MSE))
}
t_pts <- c(50, 175, 250) - tau_len
t_pts <- pmax(1, pmin(t_pts, T_est))
col_names <- c("2005 (Early)", "2015 (Reform)", "2022 (Recent)")
fevd_res <- list()
for(i in 1:3) {
mat <- calc_fevd_point(fit, t_pts[i])
# 提取核心指标:
# 1. H1: FXI(2) 对 汇率(3) 的解释力
# 2. H3: FXI(2) 对 资金流(4) 的解释力
# 3. H3: 利率(1) 对 资金流(4) 的解释力
vec <- c(mat[3, 2], mat[4, 2], mat[4, 1])
fevd_res[[col_names[i]]] <- vec
}
tbl4_data <- do.call(cbind, fevd_res)
rownames(tbl4_data) <- c("FXI explains Exchange Rate (H1)",
"FXI explains Capital Flow (H3)",
"Rate explains Capital Flow (H3)")
print(kable(tbl4_data, digits=3, caption="Table 4: Variance Decomposition Shares at Key Dates (Horizon=12)"))
# ==============================================================================
# Figure 2
# ==============================================================================
t_focus <- 175
plot_list <- list()
idx <- 1
for(i in 1:4) { # Impulse
for(j in 1:4) { # Response
irf_val <- safe_irf(fit, t_focus, i, j, hor=12)
df <- data.frame(H=1:12, Mean=irf_val)
p <- ggplot(df, aes(x=H, y=Mean)) +
geom_line(color=ifelse(i==j, "black", "blue")) +
geom_hline(yintercept=0, linetype="dashed", color="red", linewidth=0.3) +
labs(title=paste0(var_labels[i], " -> ", var_labels[j]), x="", y="") +
theme_bw() +
theme(plot.title=element_text(size=7), axis.text=element_text(size=6),
panel.grid.minor = element_blank())
plot_list[[idx]] <- p
idx <- idx + 1
}
}
grid.arrange(grobs=plot_list, nrow=4, ncol=4,
top="Figure 2: Full Impulse Responses at 2015 Reform")
# ==============================================================================
# Figure 3: H1 验证 - FXI 有效性时变趋势
# ==============================================================================
irf_h1_seq <- numeric(T_est)
for(t in 1:T_est) {
res <- impulse.responses(fit, 2, 3, t=t, nhor=2, scenario=2, draw.plot=FALSE)
irf_h1_seq[t] <- mean(res$irf[,1])
}
df_h1 <- data.frame(Time=(1:T_est)+tau_len, Response=irf_h1_seq)
p3 <- ggplot(df_h1, aes(x=Time, y=Response)) +
geom_hline(yintercept=0, color="gray50") +
geom_line(color="#1f77b4", size=1) +
geom_smooth(method="loess", color="red", linetype="dashed", se=FALSE, span=0.3) +
geom_vline(xintercept=175, linetype="dotted") +
annotate("text", x=175, y=max(df_h1$Response), label="2015 Reform", vjust=-1, hjust=0) +
labs(title="Figure 3 (H1): Time-Varying Effectiveness of FX Intervention",
subtitle="Instantaneous Response of Exchange Rate to FXI Shock",
y="Response Magnitude (Lag 1)", x="Time Index",
caption="Note: Declining magnitude indicates reduced effectiveness over time.") +
theme_minimal()
print(p3)
# ==============================================================================
# Figure 4: H2 验证 - 逆周期调节 (Scenario Comparison)
# ==============================================================================
safe_irf <- function(model, t_raw, imp, resp, hor=12) {
t_idx <- max(1, min(t_raw - tau_len, T_est))
res <- impulse.responses(model, impulse.variable=imp, response.variable=resp,
t=t_idx, nhor=hor, scenario=2, draw.plot=FALSE)
return(colMeans(res$irf))
}
# 对比 FXI(2) -> Flow(4)
res_stress <- safe_irf(fit, 175, 2, 4) # 2015
res_calm   <- safe_irf(fit, 240, 2, 4) # 2021
df_h2 <- data.frame(
Horizon = rep(1:12, 2),
Response = c(res_stress, res_calm),
Scenario = factor(rep(c("2015 (Stress Period)", "2021 (Calm Period)"), each=12))
)
p4 <- ggplot(df_h2, aes(x=Horizon, y=Response, color=Scenario)) +
geom_hline(yintercept=0, linetype="dashed", color="gray") +
geom_line(size=1.2) + geom_point(size=3) +
labs(title="Figure 4 (H2): Counter-Cyclical FXI Support on Capital Flows",
subtitle="Impulse Response Comparison: Does FXI support flows during stress?",
y="Capital Flow Response", x="Months after Shock") +
scale_color_manual(values=c("#2ca02c", "#d62728")) +
theme_minimal() + theme(legend.position = "bottom")
print(p4)
# ==============================================================================
# Figure 5: H3 验证 - 政策工具交接 (FEVD Trend)
# ==============================================================================
calc_fevd_point <- function(model, t_idx) {
B <- model$Beta.postmean[,,t_idx]; Sigma <- model$H.postmean[,,t_idx]
M <- 4; K <- M*2
A <- B[,-1]; P <- t(chol(Sigma))
F_mat <- matrix(0,K,K); F_mat[1:M,1:K]<-A; F_mat[(M+1):K,1:M]<-diag(M)
J <- matrix(0,M,K); J[1:M,1:M]<-diag(M)
MSE <- matrix(0,M,M); Phi_pow <- diag(K)
for(h in 0:11) {
Theta <- J %*% Phi_pow %*% t(J) %*% P
MSE <- MSE + Theta^2
Phi_pow <- Phi_pow %*% F_mat
}
return(MSE / rowSums(MSE))
}
fevd_seq <- matrix(0, T_est, 2)
for(t in 1:T_est) {
mat <- calc_fevd_point(fit, t)
fevd_seq[t, 1] <- mat[4, 2] # FXI->Flow
fevd_seq[t, 2] <- mat[4, 1] # Rate->Flow
}
df_h3 <- data.frame(Time=(1:T_est)+tau_len, FXI=fevd_seq[,1], Rate=fevd_seq[,2])
df_h3_long <- melt(df_h3, id="Time")
p5 <- ggplot(df_h3_long, aes(x=Time, y=value, color=variable)) +
geom_line(size=1) +
geom_vline(xintercept=175, linetype="dotted", color="gray") +
labs(title="Figure 5 (H3): Policy Drivers of Capital Flows (FEVD)",
subtitle="Variance Share: Transition from Quantity (FXI) to Price (Rate)?",
y="Variance Share Explained", x="Time Index",
caption="Orange: FX Intervention | Green: Interest Rate") +
scale_color_manual(values=c("#ff7f0e", "#2ca02c"), labels=c("FX Intervention", "Interest Rate")) +
theme_minimal() + theme(legend.position = "bottom") +
scale_y_continuous(labels = scales::percent)
print(p5)
# ==============================================================================
# Figure 6: H4/H5 验证 - 机制散点图 (Mechanism Analysis)
# ==============================================================================
if(!exists("raw_data")) raw_data <- read.csv("D:/Work/准雀/RE12039240-L/final_model_data.csv")
sub_data <- raw_data[(tau_len+1):nrow(raw_data), ]
n <- min(nrow(sub_data), nrow(df_h1))
df_mech <- data.frame(
IRF_Mag = abs(df_h1$Response[1:n]),
CC = sub_data$std_cc_index[1:n],
MPP = ifelse((sub_data$ccf_dummy[1:n] > 0) | (abs(sub_data$dep_rrr_event[1:n]) > 0), "Active", "Inactive")
)
# Subplot A (H4): Capital Control
p6a <- ggplot(df_mech, aes(x=CC, y=IRF_Mag)) +
geom_point(alpha=0.3, color="darkblue") +
geom_smooth(method="lm", color="red", size=1) +
labs(title="(a) H4: Capital Control Substitution",
subtitle="Stricter Control -> Lower FXI Impact",
x="Capital Control Intensity (Std)", y="|IRF Magnitude|") +
theme_minimal()
# Subplot B (H5): MPP Status
p6b <- ggplot(df_mech, aes(x=MPP, y=IRF_Mag, fill=MPP)) +
geom_boxplot(alpha=0.7, outlier.shape = NA) +
geom_jitter(width=0.2, alpha=0.2) +
labs(title="(b) H5: MPP Substitution Effect",
subtitle="MPP Active -> FXI Impact Vanishes",
x="Macroprudential Policy Status", y="|IRF Magnitude|") +
scale_fill_manual(values=c("#d62728", "gray70")) +
theme_minimal() + theme(legend.position="none")
# 拼图
grid.arrange(p6a, p6b, ncol=2, top="Figure 6: Mechanism Analysis (Substitution Effects)")

# ---------- Data: survival::pbc ----------
data("pbc", package = "survival")
pbc_data <- pbc %>%
dplyr::filter(!is.na(trt)) %>%                        # 跟你们旧脚本一致
dplyr::mutate(
# 竞争风险：1=死亡；2=肝移植；0=删失
status  = dplyr::case_when(status==2 ~ 1L,
status==1 ~ 2L,
TRUE      ~ 0L),
time    = time,                            # 统一到“年”
logbili = log(bili),
sex     = factor(sex),
stage   = factor(stage),
ascites = factor(ascites)
) %>%
dplyr::select(time, status, age, sex, stage, logbili, albumin, protime, ascites) %>%
tidyr::drop_na()
cat(sprintf("PBC 完整数据 n=%d\n", nrow(pbc_data)))
# ---------- Candidate models ----------
candidate_models <- list(
"M1: Baseline Clinical"    = ~ age + sex + stage,
"M2: Core Biochemical"     = ~ logbili + albumin,
"M3: Extended Biochemical" = ~ logbili + albumin + protime + ascites,
"M4: Clinical + Core Bio"  = ~ age + sex + stage + logbili + albumin,
"M5: Full"                 = ~ age + sex + stage + logbili + albumin + protime + ascites
)
# ---------- Kernels ----------
kernel_methods <- c("Uniform"=1, "Triangular"=2, "Epanechnikov"=3, "Quartic"=4)
# ---------- CV settings ----------
n_folds   <- 10
k_nn      <- 5          # 固定 k=5（不调参）
seed_cv   <- 20250101
# ---------- Helper to run both methods across 4 kernels ----------
run_both_by_kernels <- function(model_name, form, Data) {
cat(sprintf(">> %s ...\n", model_name))
rows <- list()
for (kn in names(kernel_methods)) {
kid <- kernel_methods[[kn]]
# CR 用 method_id；FG 用 kernel_id（数值映射一致）
res_cr <- CV_smoothing_CR(formula_base=form, Data=Data,
nn=k_nn, n_fold=n_folds,
method_id=kid, seed=seed_cv,
stratify=TRUE, verbose=FALSE)
res_fg <- CV_smoothing_FG(formula_base=form, Data=Data,
nn=k_nn, n_fold=n_folds,
kernel_id=kid, seed=seed_cv,
stratify=TRUE, verbose=FALSE)
rows[[length(rows)+1]] <- data.frame(
Dataset="PBC", Model=model_name, Kernel=kn,
Method="SPL-CR", Lhat=res_cr$Lhat, SE=res_cr$se_L, stringsAsFactors=FALSE)
rows[[length(rows)+1]] <- data.frame(
Dataset="PBC", Model=model_name, Kernel=kn,
Method="SPL-FG", Lhat=res_fg$Lhat, SE=res_fg$se_L, stringsAsFactors=FALSE)
}
dplyr::bind_rows(rows)
}
# ---------- Run all models ----------
tab_pbc <- dplyr::bind_rows(lapply(names(candidate_models),
function(nm) run_both_by_kernels(nm, candidate_models[[nm]], pbc_data)))
# ---------- Save long table ----------
if (!dir.exists("Results")) dir.create("Results")
readr::write_csv(tab_pbc, "Results/PBC_cv_results_by_kernel.csv")
# ---------- Pretty print: split by method into wide tables ----------
tab_cr <- tab_pbc |> dplyr::filter(Method=="SPL-CR") |>
tidyr::pivot_wider(id_cols=c(Dataset,Model), names_from=Kernel, values_from=Lhat)
tab_fg <- tab_pbc |> dplyr::filter(Method=="SPL-FG") |>
tidyr::pivot_wider(id_cols=c(Dataset,Model), names_from=Kernel, values_from=Lhat)
cat("\nPBC: Cross-validated log-score (Lhat) — SPL-CR (columns = kernels)\n")
print(
knitr::kable(tab_cr, "pipe", digits=4,
caption="PBC — SPL-CR: Lhat by kernel (k=5, time=days)") |>
kableExtra::kable_styling(bootstrap_options=c("striped","hover","condensed"), full_width=FALSE) |>
kableExtra::column_spec(2, bold=TRUE)
)
cat("\nPBC: Cross-validated log-score (Lhat) — SPL-FG (columns = kernels)\n")
print(
knitr::kable(tab_fg, "pipe", digits=4,
caption="PBC — SPL-FG: Lhat by kernel (k=5, time=days)") |>
kableExtra::kable_styling(bootstrap_options=c("striped","hover","condensed"), full_width=FALSE) |>
kableExtra::column_spec(2, bold=TRUE)
)
# ---------- Best per method (over models × kernels) ----------
best_cr <- tab_pbc |> dplyr::filter(Method=="SPL-CR") |> dplyr::slice_max(order_by=Lhat, n=1)
best_fg <- tab_pbc |> dplyr::filter(Method=="SPL-FG") |> dplyr::slice_max(order_by=Lhat, n=1)
readr::write_csv(dplyr::bind_rows(best_cr, best_fg), "Results/PBC_best_by_method.csv")
cat(sprintf("\nPBC 结论：\n  SPL-CR 最优 = [%s | %s] Lhat=%.4f\n  SPL-FG 最优 = [%s | %s] Lhat=%.4f\n",
best_cr$Model, best_cr$Kernel, best_cr$Lhat,
best_fg$Model, best_fg$Kernel, best_fg$Lhat))
